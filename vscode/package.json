{
  "name": "novnow",
  "displayName": "novnow",
  "description": "novnow language support through the official LSP server",
  "version": "0.1.2",
  "publisher": "sonneko",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sonneko/novnow"
  },
  "homepage": "https://sonneko.github.io/novnow/",
  "bugs": {
    "url": "https://github.com/sonneko/novnow/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "workspaceContains:project.toml",
    "onLanguage:novnow"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "novnow",
        "aliases": [
          "novnow"
        ],
        "configuration": "./language-configuration.json",
        "extensions": [
          ".cnov"
        ]
      }
    ],
    "commands": [
      {
        "command": "novnow.check",
        "title": "novnow: Check Project",
        "category": "novnow"
      },
      {
        "command": "novnow.export",
        "title": "novnow: Export Text",
        "category": "novnow"
      },
      {
        "command": "novnow.newProject",
        "title": "novnow: New Project",
        "category": "novnow"
      },
      {
        "command": "novnow.restartServer",
        "title": "novnow: Restart Language Server",
        "category": "novnow"
      }
    ],
    "configuration": {
      "title": "novnow",
      "properties": {
        "novnow.executablePath": {
          "type": "string",
          "default": "",
          "description": "Path to the novnow executable. When empty, PATH, the extension cache, and the official release are searched in that order."
        },
        "novnow.autoDownload": {
          "type": "boolean",
          "default": true,
          "description": "Download the checksum-verified nogui executable from the official GitHub release when no executable is installed."
        },
        "novnow.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional arguments passed to novnow before the lsp subcommand."
        }
      }
    },
    "grammars": [
      {
        "language": "novnow",
        "scopeName": "source.novnow",
        "path": "./syntaxes/novnow.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[novnow]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "semanticTokenTypes": [
      {
        "id": "sigil-structure",
        "description": "novnow sigil structure"
      },
      {
        "id": "sigil-ref",
        "description": "novnow sigil ref"
      },
      {
        "id": "scene-id",
        "description": "novnow scene id"
      },
      {
        "id": "scene-title",
        "description": "novnow scene title"
      },
      {
        "id": "ref-character",
        "description": "novnow ref character"
      },
      {
        "id": "ref-address",
        "description": "novnow ref address"
      },
      {
        "id": "ref-word",
        "description": "novnow ref word"
      },
      {
        "id": "ref-material",
        "description": "novnow ref material"
      },
      {
        "id": "ref-unresolved",
        "description": "novnow ref unresolved"
      },
      {
        "id": "citation",
        "description": "novnow citation"
      },
      {
        "id": "illustration",
        "description": "novnow illustration"
      },
      {
        "id": "modifier-mode",
        "description": "novnow modifier mode"
      },
      {
        "id": "modifier-title",
        "description": "novnow modifier title"
      },
      {
        "id": "dialogue-bracket",
        "description": "novnow dialogue bracket"
      },
      {
        "id": "dialogue-text",
        "description": "novnow dialogue text"
      },
      {
        "id": "speaker",
        "description": "novnow speaker"
      },
      {
        "id": "section-break",
        "description": "novnow section break"
      },
      {
        "id": "field-key",
        "description": "novnow field key"
      },
      {
        "id": "ruby-base",
        "description": "novnow ruby base"
      },
      {
        "id": "ruby-text",
        "description": "novnow ruby text"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "novnow",
        "scopes": {
          "sigil-structure": [
            "keyword.control.novnow"
          ],
          "sigil-ref": [
            "keyword.operator.novnow"
          ],
          "scene-id": [
            "constant.numeric.novnow"
          ],
          "scene-title": [
            "entity.name.section.novnow"
          ],
          "ref-character": [
            "entity.name.type.novnow"
          ],
          "ref-address": [
            "entity.name.type.novnow"
          ],
          "ref-word": [
            "variable.other.constant.novnow"
          ],
          "ref-material": [
            "markup.underline.link.novnow"
          ],
          "ref-unresolved": [
            "invalid.illegal.novnow"
          ],
          "citation": [
            "markup.underline.link.novnow"
          ],
          "illustration": [
            "comment.block.novnow"
          ],
          "modifier-mode": [
            "storage.modifier.novnow"
          ],
          "modifier-title": [
            "string.other.novnow"
          ],
          "dialogue-bracket": [
            "punctuation.definition.string.novnow"
          ],
          "dialogue-text": [
            "string.quoted.other.novnow"
          ],
          "speaker": [
            "entity.name.type.novnow"
          ],
          "section-break": [
            "keyword.control.novnow"
          ],
          "field-key": [
            "variable.other.property.novnow"
          ],
          "comment": [
            "comment.novnow"
          ],
          "ruby-base": [
            "string.other.novnow"
          ],
          "ruby-text": [
            "string.other.novnow"
          ]
        }
      }
    ]
  },
  "novnow": {
    "artifact": {
      "x86_64-unknown-linux-gnu": "novnow-0.1.2-x86_64-unknown-linux-gnu-nogui.tar.gz",
      "aarch64-unknown-linux-gnu": "novnow-0.1.2-aarch64-unknown-linux-gnu-nogui.tar.gz",
      "x86_64-apple-darwin": "novnow-0.1.2-x86_64-apple-darwin-nogui.tar.gz",
      "aarch64-apple-darwin": "novnow-0.1.2-aarch64-apple-darwin-nogui.tar.gz",
      "x86_64-pc-windows-msvc": "novnow-0.1.2-x86_64-pc-windows-msvc-nogui.zip"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('out',{recursive:true,force:true})\"",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc --noEmit && node esbuild.mjs",
    "test:unit": "node esbuild.mjs --unit && node --test test/*.test.cjs",
    "test:electron": "node out/test/runTest.js",
    "pretest:electron": "tsc -p tsconfig.test.json",
    "prepackage": "npm run check",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver-protocol": "^3.17.5"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.2",
    "@types/vscode": "~1.85.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.2",
    "mocha": "^11.0.1",
    "typescript": "^5.7.2"
  }
}
