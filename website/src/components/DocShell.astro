---
// docs/ から生成したページの共通の枠（左に目次、右に本文）。
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import { manualNav, specificationNav } from "../data/docs-nav";
import "../styles/doc.scss";

interface Props {
  title: string;
  current: "users" | "specifications";
  slug: string;
  source: string;
}
const { title, current, slug, source } = Astro.props;

const manualHref = (entrySlug: string) =>
  entrySlug === "index" ? "/ja/manual/" : `/ja/manual/${entrySlug}`;
const specHref = (entrySlug: string) => `/ja/specifications/${entrySlug}`;
const currentPath = current === "users" ? manualHref(slug) : specHref(slug);
---

<BaseLayout title={title} lang="ja">
  <Header lang="ja" currentPath={currentPath} />

  <div class="container" style="display: grid; grid-template-columns: 250px 1fr; gap: 2.5rem; margin-top: 2.5rem; margin-bottom: 5rem; align-items: start;">
    <aside style="position: sticky; top: 90px; max-height: calc(100vh - 120px); overflow-y: auto; background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 10px; padding: 1.1rem;">
      <div style="font-size: 0.78rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.7rem;">
        ユーザーガイド
      </div>
      <nav style="display: flex; flex-direction: column; gap: 0.15rem; margin-bottom: 1.5rem;">
        {manualNav.map((entry) => (
          <a
            href={manualHref(entry.slug)}
            aria-current={current === "users" && entry.slug === slug ? "page" : undefined}
            style:list={{ color: current === "users" && entry.slug === slug ? "var(--accent-purple)" : "var(--text-secondary)", "font-size": "0.88rem", padding: "0.3rem 0.5rem", "border-radius": "5px", "text-decoration": "none", "font-weight": current === "users" && entry.slug === slug ? "700" : "400" }}
          >
            {entry.title}
          </a>
        ))}
      </nav>

      <div style="font-size: 0.78rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.7rem;">
        仕様書
      </div>
      <nav style="display: flex; flex-direction: column; gap: 0.15rem;">
        {specificationNav.map((entry) => (
          <a
            href={specHref(entry.slug)}
            aria-current={current === "specifications" && entry.slug === slug ? "page" : undefined}
            style:list={{ color: current === "specifications" && entry.slug === slug ? "var(--accent-purple)" : "var(--text-secondary)", "font-size": "0.82rem", padding: "0.25rem 0.5rem", "border-radius": "5px", "text-decoration": "none" }}
          >
            {entry.title}
          </a>
        ))}
      </nav>
    </aside>

    <main>
      <article class="doc">
        <h1>{title}</h1>
        <slot />
      </article>

      <p style="margin-top: 3rem; padding-top: 1rem; border-top: 1px solid var(--border-color); color: var(--text-muted); font-size: 0.8rem;">
        このページは <code>{source}</code> から自動生成しています。内容の正本はリポジトリのそのファイルです。
      </p>
    </main>
  </div>

  <Footer lang="ja" />
</BaseLayout>
