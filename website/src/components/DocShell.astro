---
// docs/ から生成したページの共通の枠（左に目次、右に本文）。
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import { manualNav, specificationNav } from "../data/docs-nav";
import "../styles/doc.scss";

interface Props {
  title: string;
  current: "users" | "specifications";
  slug: string;
  source: string;
}
const { title, current, slug, source } = Astro.props;

const manualHref = (entrySlug: string) =>
  entrySlug === "index" ? "/ja/manual/" : `/ja/manual/${entrySlug}`;
const specHref = (entrySlug: string) => `/ja/specifications/${entrySlug}`;
const currentPath = current === "users" ? manualHref(slug) : specHref(slug);
---

<BaseLayout title={title} lang="ja">
  <Header lang="ja" currentPath={currentPath} />

  <div class="doc-layout">
    <aside class="doc-sidebar" aria-label="ドキュメント目次">
      <div class="doc-sidebar-group">ユーザーガイド</div>
      <nav class="doc-sidebar-nav">
        {manualNav.map((entry) => (
          <a
            href={manualHref(entry.slug)}
            aria-current={current === "users" && entry.slug === slug ? "page" : undefined}
            class="doc-sidebar-link"
          >
            <span>{entry.title}</span>
          </a>
        ))}
      </nav>

      <hr class="doc-sidebar-divider" />

      <div class="doc-sidebar-group">仕様書</div>
      <nav class="doc-sidebar-nav">
        {specificationNav.map((entry) => (
          <a
            href={specHref(entry.slug)}
            aria-current={current === "specifications" && entry.slug === slug ? "page" : undefined}
            class="doc-sidebar-link"
          >
            <span>{entry.title}</span>
          </a>
        ))}
      </nav>
    </aside>

    <main>
      <article class="doc">
        <h1>{title}</h1>
        <slot />
      </article>

      <p class="source-note">
        このページは <code>{source}</code> から自動生成しています。内容の正本はリポジトリのそのファイルです。
      </p>
    </main>
  </div>

  <Footer lang="ja" />
</BaseLayout>

<style lang="scss">
  @use "../styles/variables.scss" as *;

  .source-note {
    max-width: 820px;
    margin-top: 3rem;
    padding-top: 1.15rem;
    border-top: 1px solid $border-color;
    color: $text-muted;
    font-size: 0.84rem;
    line-height: 1.6;

    code {
      background-color: rgba(153, 161, 179, 0.15);
      color: $text-primary;
      padding: 0.12rem 0.35rem;
      border-radius: 5px;
      font-size: 0.88em;
    }
  }
</style>
