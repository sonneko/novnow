---
import type { FeatureItem } from "../data/features";
import type { Language } from "../data/i18n";
import styles from "./FeatureCard.module.scss";

interface Props {
  feature: FeatureItem;
  lang: Language;
}

const { feature, lang } = Astro.props;
---

<div class={styles.card}>
  <div class={styles.header}>
    <span class={styles.badge}>{feature.id}</span>
    <h3 class={styles.title}>{feature.title[lang]}</h3>
  </div>

  <p class={styles.summary}>{feature.summary[lang]}</p>

  <div class={styles.viewpoints}>
    <div class={styles.viewpointNonEngineer}>
      <div class={styles.viewLabel}>
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
          <path d="M8 0a8 8 0 100 16A8 8 0 008 0zM1.5 8a6.5 6.5 0 1113 0 6.5 6.5 0 01-13 0z"/>
          <path d="M8 3.5a.75.75 0 01.75.75v3.25h3.25a.75.75 0 010 1.5H8.75v3.25a.75.75 0 01-1.5 0V9H4a.75.75 0 010-1.5h3.25V4.25A.75.75 0 018 3.5z"/>
        </svg>
        作家・クリエイター視点
      </div>
      <p>{feature.nonEngineerSummary[lang]}</p>
    </div>

    <div class={styles.viewpointEngineer}>
      <div class={styles.viewLabelEng}>
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
          <path d="M4.72 3.22a.75.75 0 011.06 1.06L2.06 8l3.72 3.72a.75.75 0 11-1.06 1.06L.47 8.53a.75.75 0 010-1.06l4.25-4.25zm6.56 0a.75.75 0 10-1.06 1.06L13.94 8l-3.72 3.72a.75.75 0 101.06 1.06l4.25-4.25a.75.75 0 000-1.06l-4.25-4.25z"/>
        </svg>
        エンジニア視点
      </div>
      <p>{feature.engineerSummary[lang]}</p>
    </div>
  </div>
</div>
