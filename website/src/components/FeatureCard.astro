---
import type { FeatureItem } from "../data/features";
import type { Language } from "../data/i18n";
import { splitInlineCode } from "../utils/inlineCode";
import styles from "./FeatureCard.module.scss";

interface Props {
  feature: FeatureItem;
  lang: Language;
}

const { feature, lang } = Astro.props;
---

<div class={styles.card}>
  <div class={styles.header}>
    <span class={styles.badge}>{feature.id}</span>
    <h3 class={styles.title}>{feature.title[lang]}</h3>
  </div>

  <p class={styles.summary}>
    {splitInlineCode(feature.summary[lang]).map((part) =>
      part.href ? (
        <a href={part.href} target={part.href.startsWith("http") ? "_blank" : undefined} rel={part.href.startsWith("http") ? "noopener noreferrer" : undefined}>
          {part.code ? <code class={styles.inlineCode}>{part.text}</code> : part.text}
        </a>
      ) : part.code ? (
        <code class={styles.inlineCode}>{part.text}</code>
      ) : (
        part.text
      )
    )}
  </p>

  <div class={styles.viewpoints}>
    <div class={styles.viewpointNonEngineer}>
      <p>
        {splitInlineCode(feature.nonEngineerSummary[lang]).map((part) =>
          part.href ? (
            <a href={part.href} target={part.href.startsWith("http") ? "_blank" : undefined} rel={part.href.startsWith("http") ? "noopener noreferrer" : undefined}>
              {part.code ? <code class={styles.inlineCodeOnCard}>{part.text}</code> : part.text}
            </a>
          ) : part.code ? (
            <code class={styles.inlineCodeOnCard}>{part.text}</code>
          ) : (
            part.text
          )
        )}
      </p>
    </div>
  </div>
</div>
