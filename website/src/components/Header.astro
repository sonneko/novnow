---
import { translations, type Language } from "../data/i18n";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import styles from "./Header.module.scss";

interface Props {
  lang: Language;
  currentPath: string;
}

const { lang, currentPath: fullPath } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const currentPath = fullPath.startsWith(base + "/") ? fullPath.slice(base.length) : fullPath;
const t = translations[lang].nav;
---

<header class={styles.header}>
  <div class={styles.inner}>
    <div class={styles.brandGroup}>
      <a href={`/${lang}`} class={styles.logo}>
        <svg class={styles.logoIcon} viewBox="0 0 192 192" fill="none" aria-hidden="true">
          <rect width="192" height="192" rx="42" fill="#087EA4"/>
          <path d="M43 142V50h22l62 65V50h22v92h-22L65 77v65Z" fill="#FFFFFF"/>
          <path d="M157 41v44" stroke="#ABE2ED" stroke-width="10" stroke-linecap="round"/>
        </svg>
        <span class={styles.logoText}>NovNow</span>
      </a>
      <span class={styles.versionTag}>v1</span>
    </div>

    <nav class={styles.nav} aria-label="Primary">
      <a href={`/${lang}`} class:list={[styles.navLink, { [styles.active]: currentPath === `/${lang}` || currentPath === `/${lang}/` }]}>
        {t.home}
      </a>
      <a href={`/${lang}/manual/`} class:list={[styles.navLink, { [styles.active]: currentPath.includes("/manual") }]}>
        {t.manual}
      </a>
      <a href={`/${lang}/specifications/`} class:list={[styles.navLink, { [styles.active]: currentPath.includes("/specifications") }]}>
        {t.specs}
      </a>
      <a href={`/${lang}/api`} class:list={[styles.navLink, { [styles.active]: currentPath.includes("/api") }]}>
        {t.api}
      </a>
      <a href={`/${lang}/troubleshooting`} class:list={[styles.navLink, { [styles.active]: currentPath.includes("/troubleshooting") || currentPath.includes("/diagnostics") }]}>
        {t.troubleshooting}
      </a>
    </nav>

    <div class={styles.actions}>
      <LanguageSwitcher currentLang={lang} currentPath={currentPath} />
      <a
        href="https://github.com/sonneko/novnow"
        target="_blank"
        rel="noopener noreferrer"
        class={styles.githubBtn}
        aria-label="GitHub"
        title="GitHub"
      >
        <svg height="20" width="20" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
        </svg>
        <span class={styles.githubLabel}>GitHub</span>
      </a>
    </div>
  </div>
</header>
