---
import { illustrationSpecs } from "../data/illustrations";
import type { Language } from "../data/i18n";
import styles from "./IllustrationList.module.scss";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const labels = {
  ja: {
    title: "イラスト素材アップロードのご案内 (フリーイラスト導入手順)",
    desc: "NovNowのWebサイトデザインでは、フリーイラストやオリジナル素材を以下の各ディレクトリパスに配置することで適用される仕組みになっています。該当する画像ファイルを用意し、指定パスに保存してください。",
    targetPath: "指定配置パス:",
    dimensions: "推奨サイズ / アスペクト比:",
  },
  en: {
    title: "Illustration Upload Guide (Free Art Integration)",
    desc: "The NovNow website is designed to load artwork placed in specific directory paths. Please prepare your illustration files and save them to the designated paths below.",
    targetPath: "Target Upload Path:",
    dimensions: "Recommended Size / Aspect Ratio:",
  },
};

const l = labels[lang];
---

<div class={styles.container}>
  <div class={styles.notice}>
    <h3>{l.title}</h3>
    <p>{l.desc}</p>
  </div>

  <div class={styles.grid}>
    {illustrationSpecs.map((item) => (
      <div class={styles.card}>
        <div class={styles.header}>
          <span class={styles.badge}>{item.fileType}</span>
          <h4>{item.title[lang]}</h4>
        </div>

        <div class={styles.pathBox}>
          <span class={styles.pathLabel}>{l.targetPath}</span>
          <code>{item.targetPath}</code>
        </div>

        <p class={styles.desc}>{item.description[lang]}</p>

        <div class={styles.dimensions}>
          {l.dimensions} <strong>{item.recommendedDimensions}</strong>
        </div>
      </div>
    ))}
  </div>
</div>
