---
// トップページの各ブロック。
// 内容は docs/ と README が正本。ここには「読み方の案内」だけを置き、本文を書き写さない
// （ガイドの中身は docs/users から、入口の一覧は src/data/site.ts から取る）。
import { platforms, guideLinks } from "../data/site";
import { manualNav } from "../data/docs-nav";
import { translations, type Language } from "../data/i18n";
import { splitInlineCode } from "../utils/inlineCode";

interface Props {
  lang: Language;
}
const { lang } = Astro.props;

const text = {
  ja: {
    startTitle: "まずは手引きから",
    startLead:
      "ブラウザだけで始められます。インストールは要りません。9 段階を順に進めると、1 本の短編が書き上がります。",
    startButton: "はじめての手引き（30 分）",
    startGuideLink: "ガイドの目次",
    manualTitle: "ガイドの中身",
    manualLead:
      "このサイトのガイドは、リポジトリの docs/users/ をそのまま表示しています。書き写しではないので、直す場所は 1 か所だけです。",
    platformsTitle: "どこで動くか",
    platformsLead:
      "画面・キー操作・保存される内容は、ブラウザとデスクトップで同じです。どの入口から触っても結果は同じになります。",
    platformColumns: { name: "入口", setup: "準備", bestFor: "向いている人" },
    factsTitle: "ひと目で分かる novnow",
    specsTitle: "仕様はすべて公開されています",
    specsLead:
      "13 冊の仕様書と 13 冊の設計書がリポジトリにあり、サイトは仕様書をそのまま表示しています。ガイドで分からない言葉が出たら、そこから引いてください。",
    specsLinks: [
      { label: "仕様書（全 12 冊）", href: "/ja/specifications/" },
      { label: "診断コードの一覧", href: "/ja/diagnostics" },
      { label: "API リファレンス", href: "/ja/api" },
      { label: "困ったとき", href: "/ja/troubleshooting" },
    ],
  },
  en: {
    startTitle: "Start with the guide",
    startLead:
      "You can start in the browser — nothing to install. Nine steps take you from a blank page to a finished short story.",
    startButton: "Getting Started (30 min)",
    startGuideLink: "Guide contents",
    manualTitle: "What the guide covers",
    manualLead:
      "Every guide page on this site is rendered straight from docs/users/. There is one copy to maintain, so the site cannot fall behind.",
    platformsTitle: "Where it runs",
    platformsLead:
      "The layout, the keys, and what gets saved are the same in the browser and on the desktop. Whichever door you use, you get the same result.",
    platformColumns: { name: "Entry point", setup: "Setup", bestFor: "Best for" },
    factsTitle: "novnow at a glance",
    specsTitle: "Every specification is public",
    specsLead:
      "Thirteen specifications and thirteen design documents live in the repository, and this site renders them directly. When a word in the guide is unclear, look it up there.",
    specsLinks: [
      { label: "Specifications (12 volumes)", href: "/en/specifications/" },
      { label: "Diagnostics catalog", href: "/en/diagnostics" },
      { label: "API reference", href: "/en/api" },
      { label: "Troubleshooting", href: "/en/troubleshooting" },
    ],
  },
} as const;

const t = text[lang];
const community = translations[lang].community;

const cardNotes: Record<string, { ja: string; en: string }> = {
  start: { ja: "9 段階で、書き上げて書き出すまで", en: "Nine steps from blank page to export" },
  cheatsheet: { ja: "記号とキーだけを 1 枚に", en: "Sigils and keys on one page" },
  glossary: { ja: "「節」「モード」などの意味", en: "What section, mode, and the rest mean" },
  faq: { ja: "保存・波線・外部連携", en: "Saving, squiggles, integrations" },
  errors: { ja: "よく出る波線の直し方", en: "Fixing the common squiggles" },
  "project-structure": { ja: "作品フォルダの中身", en: "What is inside a project folder" },
  git: { ja: "履歴を残したい人だけ", en: "For keeping a history" },
  publish: { ja: "書き出した原稿の公開", en: "Publishing what you exported" },
};
const guideCards = manualNav
  .filter((entry) => entry.slug !== "index" && cardNotes[entry.slug])
  .map((entry) => ({
    href: `/ja/manual/${entry.slug}`,
    title: entry.title,
    note: cardNotes[entry.slug],
  }));

const facts = [
  { value: "9", label: { ja: "ワークスペース", en: "workspaces" }, note: { ja: "Alt+1 〜 Alt+9 で切替", en: "switch with Alt+1 – Alt+9" } },
  { value: "76", label: { ja: "リアルタイム診断", en: "live diagnostics" }, note: { ja: "すべてに固定のコード", en: "each with a stable code" } },
  { value: "5", label: { ja: "入口", en: "entry points" }, note: { ja: "CLI・LSP・MCP・Python・Rust", en: "CLI, LSP, MCP, Python, Rust" } },
  { value: "MIT", label: { ja: "ライセンス", en: "license" }, note: { ja: "仕様書も実装も自由", en: "specs and code alike" } },
];
---

<section class="section-band-wash">
  <div class="container">
    <div class="start-callout">
      <h2 class="section-heading">{t.startTitle}</h2>
      <p class="section-lead centered">{t.startLead}</p>
      <div class="start-actions">
        <a href={guideLinks.start} class="btn-primary">{t.startButton}</a>
        <a href={guideLinks.index} class="btn-secondary">{t.startGuideLink}</a>
      </div>
    </div>
  </div>
</section>

<section class="section-band-tinted">
  <div class="container">
    <div class="section-header">
      <h2 class="section-heading">{t.manualTitle}</h2>
      <p class="section-lead">{t.manualLead}</p>
    </div>
    <div class="guide-grid">
      {guideCards.map((card) => (
        <a href={card.href} class="guide-card">
          <div class="guide-card-top">
            <span class="guide-card-title">{card.title}</span>
            <span class="guide-card-arrow" aria-hidden="true">→</span>
          </div>
          <div class="guide-card-note">{card.note[lang]}</div>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="section-band-wash">
  <div class="container">
    <div class="section-header">
      <h2 class="section-heading">{t.platformsTitle}</h2>
      <p class="section-lead">{t.platformsLead}</p>
    </div>
    <div class="platform-table-wrap">
      <table class="platform-table">
        <thead>
          <tr>
            <th>{t.platformColumns.name}</th>
            <th>{t.platformColumns.setup}</th>
            <th>{t.platformColumns.bestFor}</th>
          </tr>
        </thead>
        <tbody>
          {platforms.map((row) => (
            <tr class:list={{ highlight: row.highlight }}>
              <td class="platform-name">
                <span>{row.name}</span>
                {row.highlight && <span class="recommended-pill">{lang === "ja" ? "推奨" : "Web"}</span>}
              </td>
              <td>
                {splitInlineCode(row.setup[lang]).map((part) =>
                  part.href ? (
                    <a
                      href={part.href}
                      target={part.href.startsWith("http") ? "_blank" : undefined}
                      rel={part.href.startsWith("http") ? "noopener noreferrer" : undefined}
                      class="inline-url-link"
                    >
                      {part.code ? <code class="inline-code inline-code-link">{part.text}</code> : part.text}
                    </a>
                  ) : part.code ? (
                    <code class="inline-code">{part.text}</code>
                  ) : (
                    part.text
                  )
                )}
              </td>
              <td>{row.bestFor[lang]}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="section-band-tinted">
  <div class="container">
    <h2 class="section-heading centered-heading">{t.factsTitle}</h2>
    <div class="facts-grid">
      {facts.map((fact) => (
        <div class="fact-card">
          <div class="fact-value">{fact.value}</div>
          <div class="fact-label">{fact.label[lang]}</div>
          <div class="fact-note">{fact.note[lang]}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section-band-wash" aria-labelledby="community-title">
  <div class="container">
    <div class="specs-card">
      <h2 id="community-title" class="specs-heading">{community.title}</h2>
      <p class="section-lead">{community.description}</p>
      <div class="specs-links" style="margin-top: 1.65rem">
        <a class="spec-pill" href="https://github.com/sonneko/novnow/issues">{community.contributeTitle} · {community.githubBtn}</a>
        <a class="spec-pill" href="https://github.com/sponsors/sonneko">{community.sponsorTitle}</a>
      </div>
    </div>
  </div>
</section>

<section class="section-band-wash">
  <div class="container">
    <div class="specs-card">
      <h2 class="specs-heading">{t.specsTitle}</h2>
      <p class="section-lead">{t.specsLead}</p>
      <div class="specs-links">
        {t.specsLinks.map((link) => (
          <a href={link.href} class="spec-pill">{link.label}</a>
        ))}
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  @use "../styles/variables.scss" as *;

  .section-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .section-heading {
    font-size: clamp(1.75rem, 3vw, 2.35rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.25;
    color: $text-primary;
    margin-bottom: 0.65rem;
  }

  .centered-heading {
    text-align: center;
    margin-bottom: 2.25rem;
  }

  .section-lead {
    color: $text-secondary;
    font-size: 1.05rem;
    max-width: 720px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .start-callout {
    text-align: center;
    background-color: $bg-card;
    box-shadow: $shadow-inner-border;
    border-radius: $radius-lg;
    padding: 3rem 2rem;

    .section-lead.centered {
      margin-bottom: 1.75rem;
    }
  }

  .start-actions {
    display: flex;
    gap: 0.85rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .guide-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.15rem;
  }

  .guide-card {
    display: flex;
    flex-direction: column;
    background-color: $bg-wash;
    box-shadow: $shadow-card, $shadow-inner-border;
    border-radius: $radius-md;
    padding: 1.35rem 1.45rem;
    text-decoration: none;
    transition: transform 0.18s ease, box-shadow 0.18s ease;

    &:hover {
      transform: translateY(-2px);
      box-shadow: $shadow-card-hover, inset 0 0 0 1px rgba($accent-brand, 0.28);
      text-decoration: none;

      .guide-card-title,
      .guide-card-arrow {
        color: $accent-brand;
      }

      .guide-card-arrow {
        transform: translateX(3px);
      }
    }
  }

  .guide-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.45rem;
  }

  .guide-card-title {
    color: $text-primary;
    font-weight: 700;
    font-size: 1rem;
    transition: color 0.15s ease;
  }

  .guide-card-arrow {
    color: $text-muted;
    font-weight: 600;
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .guide-card-note {
    color: $text-secondary;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .platform-table-wrap {
    overflow-x: auto;
    border-radius: $radius-md;
    box-shadow: $shadow-inner-border;
    background-color: $bg-wash;
  }

  .platform-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.94rem;

    thead tr {
      background-color: $bg-card;
      color: $text-muted;
      text-align: left;
      border-bottom: 1px solid $border-color;
    }

    th {
      padding: 0.85rem 1.15rem;
      font-weight: 700;
      font-size: 0.84rem;
      letter-spacing: 0.02em;
      white-space: nowrap;
    }

    tbody tr {
      border-top: 1px solid $border-color;

      &.highlight {
        background-color: rgba($bg-highlight, 0.55);
      }
    }

    td {
      padding: 0.85rem 1.15rem;
      color: $text-secondary;
      line-height: 1.6;
    }

    td.platform-name {
      white-space: nowrap;
      color: $text-primary;
      font-weight: 700;
    }
  }

  .recommended-pill {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.12rem 0.5rem;
    border-radius: $radius-pill;
    background-color: $bg-highlight;
    box-shadow: inset 0 0 0 1px rgba($accent-brand, 0.22);
    color: $accent-brand;
    font-size: 0.72rem;
    font-weight: 700;
    vertical-align: middle;
  }

  .inline-code {
    background-color: rgba(153, 161, 179, 0.16);
    color: $text-primary;
    padding: 0.14rem 0.4rem;
    border-radius: 6px;
    font-size: 0.86em;
  }

  .inline-url-link {
    color: $accent-brand;
    text-decoration: underline;
    text-decoration-color: rgba($accent-brand, 0.4);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.15s ease;

    &:hover {
      text-decoration-color: $accent-brand;

      .inline-code-link {
        background-color: rgba($accent-brand, 0.15);
        box-shadow: inset 0 0 0 1px rgba($accent-brand, 0.36);
      }
    }
  }

  .inline-code-link {
    background-color: $bg-highlight;
    color: $accent-brand;
    box-shadow: inset 0 0 0 1px rgba($accent-brand, 0.22);
    transition: background-color 0.15s ease, box-shadow 0.15s ease;
  }

  .facts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.15rem;
  }

  .fact-card {
    background-color: $bg-wash;
    box-shadow: $shadow-card, $shadow-inner-border;
    border-radius: $radius-md;
    padding: 1.65rem 1.25rem;
    text-align: center;
  }

  .fact-value {
    font-size: 2.35rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: $accent-brand;
    line-height: 1.1;
  }

  .fact-label {
    color: $text-primary;
    font-weight: 700;
    font-size: 1rem;
    margin-top: 0.45rem;
  }

  .fact-note {
    color: $text-muted;
    font-size: 0.84rem;
    margin-top: 0.3rem;
  }

  .specs-card {
    background-color: $bg-card;
    box-shadow: $shadow-inner-border;
    border-radius: $radius-lg;
    padding: 2.75rem 2.25rem;
    text-align: center;

    .section-lead {
      margin-bottom: 1.65rem;
    }
  }

  .specs-heading {
    font-size: clamp(1.55rem, 2.6vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: $text-primary;
    margin-bottom: 0.6rem;
  }

  .specs-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.65rem;
  }

  .spec-pill {
    display: inline-flex;
    align-items: center;
    background-color: $bg-wash;
    box-shadow: $shadow-secondary-stroke;
    border-radius: $radius-pill;
    padding: 0.55rem 1.15rem;
    color: $text-primary;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease, box-shadow 0.15s ease;

    &:hover {
      background-color: $bg-highlight;
      box-shadow: inset 0 0 0 1px rgba($accent-brand, 0.35);
      color: $accent-brand;
      text-decoration: none;
    }
  }
</style>
