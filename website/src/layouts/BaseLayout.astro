---
import "../styles/global.scss";

interface Props {
  title: string;
  description?: string;
  lang?: "ja" | "en";
}

const { title, description = "NovNow - Dedicated Novel & Scenario IDE for Writers & Engineers", lang = "ja" } = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | NovNow</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <slot />
  </body>
</html>
