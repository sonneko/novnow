---
import "../styles/global.scss";
import ReleaseNotice from "../components/ReleaseNotice.astro";

interface Props {
  title: string;
  description?: string;
  lang?: "ja" | "en";
}

const { title, description = "NovNow - Dedicated Novel & Scenario IDE for Writers & Engineers", lang = "ja" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const languagePath = Astro.url.pathname.replace(/\/(ja|en)(?=\/|$)/, '/LANG');
const translatedUrl = (language: string) => new URL(languagePath.replace('/LANG', `/${language}`), Astro.site);
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" />
    <title>{title} | NovNow</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ja" href={translatedUrl("ja")} />
    <link rel="alternate" hreflang="en" href={translatedUrl("en")} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <ReleaseNotice lang={lang} />
    <slot />
  </body>
</html>
