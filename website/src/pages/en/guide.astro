---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import GuideSection from "../../components/GuideSection.astro";
import Footer from "../../components/Footer.astro";
import { featuresData } from "../../data/features";

const lang = "en";
---

<BaseLayout title="Feature Guide (Writers & Engineers)" lang={lang}>
  <Header lang={lang} currentPath="/en/guide" />

  <main class="container" style="margin-top: 3rem; margin-bottom: 5rem;">
    <div style="margin-bottom: 3rem; text-align: center;">
      <h1 style="font-size: 2.25rem; font-weight: 800; color: var(--text-primary); margin-bottom: 0.75rem;">
        NovNow Feature Guide & Technical Breakdown
      </h1>
      <p style="color: var(--text-secondary); max-width: 760px; margin: 0 auto; line-height: 1.6;">
        Detailed guide covering all features of NovNow from dual viewpoints: practical workflow benefits for creative authors, and architectural design specifications for software engineers.
      </p>
    </div>

    <!-- Navigation jump anchors -->
    <div style="background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 8px; padding: 1rem 1.5rem; margin-bottom: 3rem; display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center;">
      <span style="font-size: 0.85rem; font-weight: 700; color: var(--text-muted);">Jump to feature:</span>
      {featuresData.map((f) => (
        <a href={`#${f.id}`} style="font-size: 0.85rem; color: var(--accent-blue); background-color: var(--bg-subtle); padding: 0.2rem 0.5rem; border-radius: 4px;">
          {f.id}
        </a>
      ))}
    </div>

    <!-- Guide sections -->
    <div>
      {featuresData.map((feature) => (
        <GuideSection feature={feature} lang={lang} />
      ))}
    </div>
  </main>

  <Footer lang={lang} />
</BaseLayout>
