---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import GuideSection from "../../components/GuideSection.astro";
import Footer from "../../components/Footer.astro";
import { featuresData } from "../../data/features";

const lang = "en";
---

<BaseLayout title="Feature Guide & Reference" lang={lang}>
  <Header lang={lang} currentPath="/en/guide" />

  <div class="doc-layout">
    <aside class="doc-sidebar" aria-label="Feature Reference">
      <div class="doc-sidebar-group">Feature Reference</div>
      <nav class="doc-sidebar-nav">
        {featuresData.map((f) => (
          <a href={`#${f.id}`} class="doc-sidebar-link">
            <span>{f.title[lang]}</span>
          </a>
        ))}
      </nav>
    </aside>

    <main style="max-width: 860px;">
      <div style="margin-bottom: 2.5rem;">
        <h1 style="font-size: clamp(2rem, 3.4vw, 2.5rem); font-weight: 800; letter-spacing: -0.025em; color: var(--text-primary); margin-bottom: 0.65rem;">
          NovNow Feature Reference
        </h1>
        <p style="color: var(--text-secondary); line-height: 1.7; font-size: 1.08rem;">
          Detailed reference documentation for all core features supporting structured novel writing in NovNow.
        </p>
      </div>

      <div>
        {featuresData.map((feature) => (
          <GuideSection feature={feature} lang={lang} />
        ))}
      </div>
    </main>
  </div>

  <Footer lang={lang} />
</BaseLayout>
