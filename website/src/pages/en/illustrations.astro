---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import IllustrationList from "../../components/IllustrationList.astro";
import Footer from "../../components/Footer.astro";

const lang = "en";
---

<BaseLayout title="Illustration Upload Specifications" lang={lang}>
  <Header lang={lang} currentPath="/en/illustrations" />

  <main class="container" style="margin-top: 3rem; margin-bottom: 5rem;">
    <div style="margin-bottom: 2.5rem; text-align: center;">
      <h1 style="font-size: 2.25rem; font-weight: 800; color: var(--text-primary); margin-bottom: 0.75rem;">
        Required Illustration Artwork Specifications
      </h1>
      <p style="color: var(--text-secondary); max-width: 760px; margin: 0 auto; line-height: 1.6;">
        Guide specifying exact file directory paths, recommended dimensions, and descriptions for free or custom illustrations.
      </p>
    </div>

    <IllustrationList lang={lang} />
  </main>

  <Footer lang={lang} />
</BaseLayout>
