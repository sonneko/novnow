---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Hero from "../../components/Hero.astro";
import FeatureCard from "../../components/FeatureCard.astro";
import Footer from "../../components/Footer.astro";
import Overview from "../../components/Overview.astro";
import { featuresData } from "../../data/features";

const lang = "en";
---

<BaseLayout title="Dedicated Novel & Scenario IDE" lang={lang}>
  <Header lang={lang} currentPath="/en" />

  <main>
    <Hero lang={lang} />

    <!-- Feature Grid Section -->
    <section class="section-band-tinted">
      <div class="container">
        <div style="text-align: center; margin-bottom: 2.75rem;">
          <h2 style="font-size: clamp(1.85rem, 3.2vw, 2.5rem); font-weight: 800; letter-spacing: -0.025em; color: var(--text-primary); margin-bottom: 0.6rem;">
            Key Features of NovNow
          </h2>
          <p style="color: var(--text-secondary); font-size: 1.06rem; max-width: 680px; margin: 0 auto; line-height: 1.7;">
            Designed to structure long-form story writing and maximize immersion during creative work.
          </p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.35rem;">
          {featuresData.map((feature) => (
            <FeatureCard feature={feature} lang={lang} />
          ))}
        </div>
      </div>
    </section>

    <Overview lang="en" />
  </main>

  <Footer lang={lang} />
</BaseLayout>
