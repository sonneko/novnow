---
// ガイドの本文は日本語のみ（docs/users が正本）。英語の利用者には、その旨と日本語版への道を出す。
import { manualNav } from "../../../data/docs-nav";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";

export function getStaticPaths() {
  return [
    { params: { slug: undefined } },
    ...manualNav.filter((entry) => entry.slug !== "index").map((entry) => ({ params: { slug: entry.slug } })),
  ];
}
const { slug } = Astro.params;
const japanese = slug ? `/ja/manual/${slug}` : "/ja/manual/";
---

<BaseLayout title="Guide" lang="en">
  <Header lang="en" currentPath="/en/manual/" />
  <main class="container" style="max-width: 760px; margin: 3.5rem auto 6rem;">
    <div style="background-color: var(--bg-card); box-shadow: var(--shadow-inner-border); border-radius: 24px; padding: 2.5rem;">
      <h1 style="font-size: clamp(1.75rem, 3vw, 2.2rem); font-weight: 800; letter-spacing: -0.025em; color: var(--text-primary); margin-bottom: 1rem;">
        The guides are written in Japanese for now
      </h1>
      <p style="color: var(--text-secondary); line-height: 1.8; font-size: 1.02rem;">
        The user guides are generated from <code style="background-color: rgba(153,161,179,0.16); padding: 0.14rem 0.38rem; border-radius: 6px;">docs/users/</code>, and that text is currently Japanese only.
        Translating them is tracked as its own task so that the site and the app never drift apart.
      </p>
      <div style="margin: 1.85rem 0;">
        <a href={japanese} class="btn-primary">
          Read this page in Japanese →
        </a>
      </div>
      <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.7;">
        The specifications (<code style="background-color: rgba(153,161,179,0.16); padding: 0.12rem 0.35rem; border-radius: 5px;">docs/specifications/</code>) are also Japanese only.
        The diagnostics catalog and the API reference below are available in English.
      </p>
      <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 1.25rem;">
        <a href="/en/diagnostics" class="btn-secondary">Diagnostics catalog</a>
        <a href="/en/api" class="btn-secondary">API reference</a>
      </div>
    </div>
  </main>
  <Footer lang="en" />
</BaseLayout>
