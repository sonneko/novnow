---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import TroubleshootingItem from "../../components/TroubleshootingItem.astro";
import Footer from "../../components/Footer.astro";
import { troubleshootingData } from "../../data/troubleshooting";

const lang = "en";
---

<BaseLayout title="Troubleshooting Guide & Reference" lang={lang}>
  <Header lang={lang} currentPath="/en/troubleshooting" />

  <div class="doc-layout">
    <aside class="doc-sidebar" aria-label="Troubleshooting Topics">
      <div class="doc-sidebar-group">Troubleshooting Topics</div>
      <nav class="doc-sidebar-nav">
        {troubleshootingData.map((item) => (
          <a href={`#${item.id}`} class="doc-sidebar-link">
            <span>{item.title[lang]}</span>
          </a>
        ))}
      </nav>
    </aside>

    <main style="max-width: 860px;">
      <div style="margin-bottom: 1.75rem;">
        <h1 style="font-size: clamp(2rem, 3.4vw, 2.5rem); font-weight: 800; letter-spacing: -0.025em; color: var(--text-primary); margin-bottom: 0.65rem;">
          Troubleshooting Reference
        </h1>
        <p style="color: var(--text-secondary); line-height: 1.7; font-size: 1.08rem;">
          Reference index for common setup issues, errors, diagnostic alerts, and resolution steps in NovNow.
        </p>
      </div>

      <div style="margin-bottom: 2rem;">
        <a href="/en/diagnostics" class="btn-secondary">Browse every diagnostic code →</a>
      </div>

      <div>
        {troubleshootingData.map((item) => (
          <TroubleshootingItem item={item} lang={lang} />
        ))}
      </div>
    </main>
  </div>

  <Footer lang={lang} />
</BaseLayout>
