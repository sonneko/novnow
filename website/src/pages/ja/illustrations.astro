---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import IllustrationList from "../../components/IllustrationList.astro";
import Footer from "../../components/Footer.astro";

const lang = "ja";
---

<BaseLayout title="イラスト素材・アップロード一覧" lang={lang}>
  <Header lang={lang} currentPath="/ja/illustrations" />

  <main class="container" style="margin-top: 3rem; margin-bottom: 5rem;">
    <div style="margin-bottom: 2.5rem; text-align: center;">
      <h1 style="font-size: 2.25rem; font-weight: 800; color: var(--text-primary); margin-bottom: 0.75rem;">
        必要なイラスト素材・アップロード仕様書
      </h1>
      <p style="color: var(--text-secondary); max-width: 760px; margin: 0 auto; line-height: 1.6;">
        NovNowWebサイトのビジュアル向上のため、フリーイラスト素材または描き下ろしイラストの追加アップロードガイドです。どのディレクトリのどのパス名でどんな画像を配置すべきかの指定一覧です。
      </p>
    </div>

    <IllustrationList lang={lang} />
  </main>

  <Footer lang={lang} />
</BaseLayout>
