---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Hero from "../../components/Hero.astro";
import FeatureCard from "../../components/FeatureCard.astro";
import Footer from "../../components/Footer.astro";
import { featuresData } from "../../data/features";
import { translations } from "../../data/i18n";

const lang = "ja";
const t = translations[lang];
---

<BaseLayout title="長編小説・シナリオ執筆専用 IDE" lang={lang}>
  <Header lang={lang} currentPath="/ja" />

  <main>
    <Hero lang={lang} />

    <!-- Feature Grid Section -->
    <section class="container" style="margin-top: 4rem; margin-bottom: 5rem;">
      <div style="text-align: center; margin-bottom: 3rem;">
        <h2 style="font-size: 2rem; font-weight: 800; color: var(--text-primary); margin-bottom: 0.5rem;">
          NovNowの主要機能
        </h2>
        <p style="color: var(--text-secondary); max-width: 680px; margin: 0 auto;">
          長編小説・シナリオの執筆を構造化し、アイデアと執筆の没入感を最大化する機能群。
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem;">
        {featuresData.map((feature) => (
          <FeatureCard feature={feature} lang={lang} />
        ))}
      </div>
    </section>

    <!-- Community & Sponsor Section (Commented out until contribute readiness is complete) -->
