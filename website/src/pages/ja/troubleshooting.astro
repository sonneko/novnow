---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import TroubleshootingItem from "../../components/TroubleshootingItem.astro";
import Footer from "../../components/Footer.astro";
import { troubleshootingData } from "../../data/troubleshooting";

const lang = "ja";
---

<BaseLayout title="トラブルシューティング" lang={lang}>
  <Header lang={lang} currentPath="/ja/troubleshooting" />

  <main class="container" style="margin-top: 3rem; margin-bottom: 5rem;">
    <div style="margin-bottom: 3rem; text-align: center;">
      <h1 style="font-size: 2.25rem; font-weight: 800; color: var(--text-primary); margin-bottom: 0.75rem;">
        トラブルシューティング & エラー対処ガイド
      </h1>
      <p style="color: var(--text-secondary); max-width: 760px; margin: 0 auto; line-height: 1.6;">
        プロジェクト起動時のエラー、ファイル形式の不整合、診断警告、AI MCP接続、Web版のストレージ制限など、よくある問題とその具体的な解決手順を掲載しています。
      </p>
    </div>

    <div>
      {troubleshootingData.map((item) => (
        <TroubleshootingItem item={item} lang={lang} />
      ))}
    </div>
  </main>

  <Footer lang={lang} />
</BaseLayout>
