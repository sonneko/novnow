---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import TroubleshootingItem from "../../components/TroubleshootingItem.astro";
import Footer from "../../components/Footer.astro";
import { troubleshootingData } from "../../data/troubleshooting";

const lang = "ja";
---

<BaseLayout title="トラブルシューティング・解決ガイド" lang={lang}>
  <Header lang={lang} currentPath="/ja/troubleshooting" />

  <div class="doc-layout">
    <aside class="doc-sidebar" aria-label="問題カテゴリ一覧">
      <div class="doc-sidebar-group">問題カテゴリ一覧</div>
      <nav class="doc-sidebar-nav">
        {troubleshootingData.map((item) => (
          <a href={`#${item.id}`} class="doc-sidebar-link">
            <span>{item.title[lang]}</span>
          </a>
        ))}
      </nav>
    </aside>

    <main style="max-width: 860px;">
      <div style="margin-bottom: 1.75rem;">
        <h1 style="font-size: clamp(2rem, 3.4vw, 2.5rem); font-weight: 800; letter-spacing: -0.025em; color: var(--text-primary); margin-bottom: 0.65rem;">
          トラブルシューティング・リファレンス
        </h1>
        <p style="color: var(--text-secondary); line-height: 1.7; font-size: 1.08rem;">
          NovNowの利用中に発生するよくあるエラー・不具合・設定問題の原因と個別の解決策をまとめたリファレンスです。
        </p>
      </div>

      <div style="margin-bottom: 2rem;">
        <a href="/ja/diagnostics" class="btn-secondary">全診断コードの解説を見る →</a>
      </div>

      <div>
        {troubleshootingData.map((item) => (
          <TroubleshootingItem item={item} lang={lang} />
        ))}
      </div>
    </main>
  </div>

  <Footer lang={lang} />
</BaseLayout>
