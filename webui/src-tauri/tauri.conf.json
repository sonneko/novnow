{
  "productName": "novnow-webui-native",
  "version": "0.0.0",
  "identifier": "io.github.sonneko.novnow.webui.dev",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5273",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "novnow (webui dev)",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 400,
        "incognito": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
